from django import forms
from django.contrib.auth.forms import PasswordChangeForm
from django.contrib.auth.password_validation import validate_password

from apps.academic.models import Student

from .models import User

INPUT_CLASS = "input input-bordered w-full"


class StyledMixin:
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        for field in self.fields.values():
            field.widget.attrs.setdefault("class", INPUT_CLASS)


class RegisterForm(StyledMixin, forms.ModelForm):
    password1 = forms.CharField(label="Password", strip=False, widget=forms.PasswordInput)
    password2 = forms.CharField(label="Konfirmasi password", strip=False, widget=forms.PasswordInput)

    class Meta:
        model = User
        fields = ["username", "name", "email"]
        labels = {"username": "Username", "name": "Nama", "email": "Email"}

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.fields["name"].required = True
        self.fields["email"].required = True

    def clean_email(self):
        return self.cleaned_data["email"].lower()

    def clean_password1(self):
        password = self.cleaned_data.get("password1")
        if password:
            validate_password(password)
        return password

    def clean(self):
        cleaned = super().clean()
        if cleaned.get("password1") and cleaned.get("password1") != cleaned.get("password2"):
            self.add_error("password2", "Konfirmasi password tidak sama.")
        return cleaned

    def save(self, commit=True):
        user = super().save(commit=False)
        user.set_password(self.cleaned_data["password1"])
        if commit:
            user.save()
        return user


class ProfileForm(StyledMixin, forms.ModelForm):
    class Meta:
        model = User
        fields = ["name", "email"]
        labels = {"name": "Nama", "email": "Email"}

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.fields["name"].required = True
        self.fields["email"].required = True

    def clean_email(self):
        return self.cleaned_data["email"].lower()


class StudentProfileForm(StyledMixin, forms.ModelForm):
    class Meta:
        model = Student
        fields = [
            "phone_number", "home_phone", "address", "postal_code", "birth_place", "birth_date",
        ]
        labels = {
            "phone_number": "No. handphone",
            "home_phone": "Telepon rumah",
            "address": "Alamat",
            "postal_code": "Kode pos",
            "birth_place": "Tempat lahir",
            "birth_date": "Tanggal lahir",
        }
        widgets = {"birth_date": forms.DateInput(attrs={"type": "date"})}


class ChangePasswordForm(StyledMixin, PasswordChangeForm):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.fields["old_password"].label = "Password lama"
        self.fields["new_password1"].label = "Password baru"
        self.fields["new_password2"].label = "Konfirmasi password baru"
