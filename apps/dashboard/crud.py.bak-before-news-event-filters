@dataclass
class CrudSpec:
    key: str  # dipakai sebagai path dan prefix nama URL, mis. "study-programs"
    title: str
    model: type
    form: type
    perm: Optional[str]  # codename permission, mis. "manage_news"
    columns: list  # field yang ditampilkan di tabel list
    owner_field: Optional[str] = (
        None  # field pemilik; staff hanya boleh ubah miliknya sendiri
    )
    admin_only: bool = False
    list_template: str = "dashboard/crud/list.html"
    search_field: Optional[str] = (
        None  # field yang dicari lewat ?search= di halaman list
    )
    form_template: str = "dashboard/crud/form.html"
    base_filter: dict = field(
        default_factory=dict
    )  # filter tetap untuk daftar, mis. hanya degree program
    detail_template: str = "dashboard/crud/detail.html"
    detail_context: Optional[Callable] = (
        None  # (obj, request) -> dict konteks tambahan untuk halaman detail
    )
    list_filter: Optional[Callable] = (
        None  # (qs, request) -> (qs, dict konteks): filter dropdown di halaman list
    )
    url_name: str = field(init=False)

    def __post_init__(self):
        self.url_name = self.key.replace("-", "_")


def _str_limit(text, limit, end="..."):
    """Pengganti Str::limit(html_entity_decode(strip_tags($text)), $limit, $end) di Laravel."""
    clean = html.unescape(strip_tags(text or ""))
    return clean[:limit] + end if len(clean) > limit else clean


def _program_detail_context(obj, request):
    accepted = (
        obj.enrollments.select_related("student")
        .filter(status="approved")
        .order_by("-pk")
    )
    pending = (
        obj.enrollments.select_related("student")
        .filter(status="pending")
        .order_by("created_at")
    )
    return {
        "accepted_page": Paginator(accepted, 10).get_page(request.GET.get("page")),
        "pending_enrollments": pending,
        "description_excerpt": _str_limit(obj.description, 150),
    }


def _parse_iso_date(value):
    """Parse YYYY-MM-DD dari query string; None jika kosong atau tidak valid."""
    try:
        return datetime.date.fromisoformat((value or "").strip())
    except ValueError:
        return None


def _qs_with(request, **changes):
    """Query string dari request saat ini dengan perubahan parameter (None = hapus)."""
    query = request.GET.copy()
    query.pop("page", None)
    for key, value in changes.items():
        if value is None:
            query.pop(key, None)
        else:
            query[key] = value
    return "?" + query.urlencode() if query else "?"


def _agenda_list_filter(qs, request):
    """Filter list Agenda: status, tanggal terpilih di kalender, dan kalender bulanan."""
    now = timezone.now()
    today = timezone.localdate()
    status = request.GET.get("status", "").strip()
    selected_date = _parse_iso_date(request.GET.get("date", ""))
    month_start = _parse_iso_date(request.GET.get("month", "") + "-01")
    base = selected_date or month_start or today

    year, month = base.year, base.month
    first = datetime.date(year, month, 1)
    last = datetime.date(year, month, calendar.monthrange(year, month)[1])

    if status == "upcoming":
        qs = qs.filter(start__gt=now)
    elif status == "ongoing":
        qs = qs.filter(start__lte=now, end__gte=now)
    elif status == "finished":
        qs = qs.filter(end__lt=now)
    else:
        status = ""

    # Jumlah agenda per hari untuk mini-kalender (mengikuti search dan status).
    counts = collections.Counter()
    for agenda in qs.filter(start__date__lte=last, end__date__gte=first):
        day = max(timezone.localtime(agenda.start).date(), first)
        end_day = min(timezone.localtime(agenda.end).date(), last)
        while day <= end_day:
            counts[day] += 1
            day += datetime.timedelta(days=1)

    table_qs = qs
    if selected_date:
        table_qs = table_qs.filter(start__date__lte=selected_date, end__date__gte=selected_date)

    weeks = []
    for week in calendar.Calendar(firstweekday=0).monthdatescalendar(year, month):
        weeks.append([
            {
                "date": day,
                "in_month": day.month == month,
                "count": counts.get(day, 0),
                "is_today": day == today,
                "selected": day == selected_date,
                "href": _qs_with(
                    request,
                    month=first.strftime("%Y-%m"),
                    date=None if day == selected_date else day.isoformat(),
                ),
            }
            for day in week
        ])

    prev_first = (first - datetime.timedelta(days=1)).replace(day=1)
    next_first = last + datetime.timedelta(days=1)
    return table_qs.order_by("start"), {
        "cal_month": first.strftime("%Y-%m"),
        "cal_title": first.strftime("%B %Y"),
        "cal_weeks": weeks,
        "cal_prev": _qs_with(request, month=prev_first.strftime("%Y-%m"), date=None),
        "cal_next": _qs_with(request, month=next_first.strftime("%Y-%m"), date=None),
        "cal_today": _qs_with(request, month=today.strftime("%Y-%m"), date=None),
        "weekday_names": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
        "selected_date": selected_date,
        "selected_date_clear": _qs_with(request, date=None),
        "status_choices": [
            ("upcoming", "Upcoming"),
            ("ongoing", "Ongoing"),
            ("finished", "Finished"),
        ],
        "selected": {"status": status},
        "now": now,
    }


def _program_list_filter(qs, request):
    """Filter dropdown halaman list Programs: IE Program, Country, dan status waktu."""
    today = datetime.date.today()
    ie_id = request.GET.get("ie_program", "").strip()
    country = request.GET.get("country", "").strip()
    status = request.GET.get("status", "").strip()

    if ie_id.isdigit():
        qs = qs.filter(ie_program_id=int(ie_id))
    if country:
        qs = qs.filter(country=country)
    if status == "upcoming":
        qs = qs.filter(execution_date__gt=today)
    elif status == "ongoing":
        qs = qs.filter(execution_date__lte=today, end_date__gte=today)
    elif status == "finished":
        qs = qs.filter(end_date__lt=today)
    else:
        status = ""

    countries = (
        Program.objects.exclude(country="")
        .order_by("country")
        .values_list("country", flat=True)
        .distinct()
    )
    return qs, {
        "ie_programs": IeProgram.objects.order_by("name"),
        "countries": countries,
        "status_choices": [
            ("upcoming", "Upcoming"),
            ("ongoing", "Ongoing"),
            ("finished", "Finished"),
        ],
        "selected": {"ie_program": ie_id, "country": country, "status": status},
    }


def _study_program_list_filter(qs, request):
    """Filter dropdown halaman list Study Programs: Faculty."""
    faculty_id = request.GET.get("faculty", "").strip()
    if faculty_id.isdigit():
        qs = qs.filter(faculty_id=int(faculty_id))
    else:
        faculty_id = ""
    return qs, {
        "faculties": Faculty.objects.order_by("name"),
        "selected": {"faculty": faculty_id},
    }


def _partnership_list_filter(qs, request):
    """Filter dropdown halaman list Partnerships: Type, Status, dan Country."""
    allowed_types = ("double_degree", "joint_degree")
    ptype = request.GET.get("type", "").strip()
    status = request.GET.get("status", "").strip()
    country = request.GET.get("country", "").strip()

    if ptype in allowed_types:
        qs = qs.filter(partnership_type=ptype)
    else:
        ptype = ""
    if status == "active":
        qs = qs.filter(is_active=True)
    elif status == "inactive":
        qs = qs.filter(is_active=False)
    else:
        status = ""
    if country:
        qs = qs.filter(country=country)

    countries = (
        Partnership.objects.filter(partnership_type__in=allowed_types)
        .exclude(country__isnull=True)
        .exclude(country="")
        .order_by("country")
        .values_list("country", flat=True)
        .distinct()
    )
    return qs, {
        "type_choices": [("double_degree", "Double Degree"), ("joint_degree", "Joint Degree")],
        "status_choices": [("active", "Active"), ("inactive", "Inactive")],
        "countries": countries,
        "selected": {"type": ptype, "status": status, "country": country},
    }


