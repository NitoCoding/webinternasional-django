class StudyProgramForm(StyledModelForm):
    class Meta:
        model = StudyProgram
        fields = [
            "faculty", "name", "degree", "description", "image", "classrooms", "lecturers",
            "national_accreditation", "international_accreditation", "approval_sk", "opening_year",
            "director_name", "director_contact", "ukt_fee", "ipi_fee", "international_exposure",
            "total_courses", "rps_courses_in_english", "teaching_materials_in_english",
            "courses_delivered_in_english", "courses_fully_filled_in_sikola",
        ]

    # field setelah image ditampilkan dalam dua kolom
    two_column_fields = [
        "classrooms", "lecturers", "national_accreditation", "international_accreditation", "approval_sk",
        "opening_year", "director_name", "director_contact", "ukt_fee", "ipi_fee", "international_exposure",
        "total_courses", "rps_courses_in_english", "teaching_materials_in_english",
        "courses_delivered_in_english", "courses_fully_filled_in_sikola",
    ]

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.fields["name"].widget.attrs["data-autocomplete-url"] = reverse("dashboard:study_program_autocomplete")
        if self.instance.pk is None:
            self.fields["image"].required = True

    def clean_name(self):
        name = self.cleaned_data["name"]
        if self.instance.pk is None and StudyProgram.objects.filter(name=name).exists():
            raise forms.ValidationError("Program studi sudah ada.")
        if name not in valid_study_program_names():
            raise forms.ValidationError("Nama program studi tidak valid.")
        return name


class ProgramForm(StyledModelForm):
    class Meta:
        model = Program
        fields = [
            "name", "description", "country", "execution_date", "end_date", "participants_count",
            "course_credits", "image", "brochure_pdf", "ie_program", "study_programs",
        ]

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.fields["study_programs"].required = True
        if self.instance.pk is None:
            self.fields["image"].required = True

    def clean(self):
        cleaned = super().clean()
        start, end = cleaned.get("execution_date"), cleaned.get("end_date")
        if start and end and end < start:
            self.add_error("end_date", "Tanggal akhir harus sama atau setelah tanggal pelaksanaan.")
        return cleaned


