INPUT_CLASS = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
INPUT_SM_CLASS = "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
IMAGE_MAX_BYTES = 2 * 1024 * 1024
IMAGE_EXTENSIONS = {".jpg", ".jpeg", ".png", ".gif", ".webp"}


class SiteSettingsForm(forms.Form):
    """Form halaman Site Settings, setara dengan SiteSettingController::update di Laravel."""

    about_title = forms.CharField(max_length=255, label="Section Title",
                                  widget=forms.TextInput(attrs={"class": INPUT_CLASS}))
    about_paragraph_1 = forms.CharField(label="First Paragraph",
                                        widget=forms.Textarea(attrs={"rows": 4, "class": INPUT_CLASS}))
    about_paragraph_2 = forms.CharField(label="Second Paragraph",
                                        widget=forms.Textarea(attrs={"rows": 4, "class": INPUT_CLASS}))
    about_image = forms.ImageField(
        required=False, label="About Image",
        error_messages={"invalid_image": "File harus berupa gambar."},
        widget=forms.FileInput(attrs={
            "accept": "image/*", "onchange": "previewImage(this)",
            "class": "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 "
                     "focus:border-blue-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 "
                     "file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100",
        }),
    )
    footer_address = forms.CharField(max_length=500, required=False, label="Address",
                                     widget=forms.Textarea(attrs={"rows": 2, "class": INPUT_CLASS}))
    footer_phone = forms.CharField(max_length=50, required=False, label="Phone",
                                   widget=forms.TextInput(attrs={"class": INPUT_CLASS}))
    footer_email = forms.EmailField(max_length=100, required=False, label="Email",
                                    error_messages={"invalid": "Format email tidak valid."},
                                    widget=forms.EmailInput(attrs={"class": INPUT_CLASS}))

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        for i in range(1, 5):
            self.fields[f"ie_card_{i}_title"] = forms.CharField(
                max_length=100, label="Title", widget=forms.TextInput(attrs={"class": INPUT_SM_CLASS}))
            self.fields[f"ie_card_{i}_desc"] = forms.CharField(
                max_length=255, label="Description", widget=forms.Textarea(attrs={"rows": 2, "class": INPUT_SM_CLASS}))

    @property
    def ie_cards(self):
        return [(i, self[f"ie_card_{i}_title"], self[f"ie_card_{i}_desc"]) for i in range(1, 5)]

    def clean_about_image(self):
        image = self.cleaned_data.get("about_image")
        if image:
            if image.size > IMAGE_MAX_BYTES:
                raise forms.ValidationError("Ukuran gambar terlalu besar! Maksimal 2MB.")
            if Path(image.name).suffix.lower() not in IMAGE_EXTENSIONS:
                raise forms.ValidationError("Format gambar harus JPEG, PNG, GIF, atau WebP.")
        return image

    def save(self):
        data = self.cleaned_data
        values = {
            "about_title": ("text", data["about_title"]),
            "about_paragraph_1": ("html", data["about_paragraph_1"]),
            "about_paragraph_2": ("html", data["about_paragraph_2"]),
        }
        for i in range(1, 5):
            values[f"ie_card_{i}_title"] = ("text", data[f"ie_card_{i}_title"])
            values[f"ie_card_{i}_desc"] = ("text", data[f"ie_card_{i}_desc"])
        for key, default in FOOTER_DEFAULTS.items():
            values[key] = ("text", data[key] or default)
        for key, (setting_type, value) in values.items():
            SiteSetting.objects.update_or_create(key=key, defaults={"value": value, "type": setting_type})

        image = data.get("about_image")
        if image:
            old = SiteSetting.get("about_image")
            if old and old.startswith("settings/") and default_storage.exists(old):
                default_storage.delete(old)
            path = default_storage.save(f"settings/{image.name}", image)
            SiteSetting.objects.update_or_create(key="about_image", defaults={"value": path, "type": "image"})
